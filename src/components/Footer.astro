---
// Footer.astro
import pkg from "lucide-react";

const { MapPin, Mail, Phone } = pkg;
---
<footer id="kontak-footer" class="w-full bg-white border-t border-gray-100 pt-16 pb-8">
  <div class="max-w-[1400px] mx-auto px-6">
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      {/* Brand & Description */}
      <div class="md:col-span-2">
        <div class="flex items-center mb-6">
          <img src="/images/logo_cropped.png" alt="GIS Logo" class="h-10 w-auto object-contain" />
          <div class="flex flex-col justify-center ml-2 items-center">
            <div class="text-[14px] md:text-[16px] font-extrabold tracking-tighter uppercase leading-none mb-1 flex items-center space-x-1 whitespace-nowrap">
              <span class="text-[#083d8d]">PT . GAJATRI</span>
              <span class="text-[#474747]">INDO</span>
              <span class="text-[#083d8d]">SERVICE</span>
            </div>
            <div class="flex items-center w-full">
              <div class="h-[1px] bg-[#083d8d] flex-grow"></div>
              <div class="text-[7px] md:text-[8px] font-bold tracking-widest text-[#474747] mx-2 flex items-center space-x-1 uppercase whitespace-nowrap">
                <div class="w-1 h-1 rounded-full bg-[#083d8d]"></div>
                <span>SOLUSI</span>
                <div class="w-1 h-1 rounded-full bg-[#083d8d]"></div>
                <span>KUALITAS</span>
                <div class="w-1 h-1 rounded-full bg-[#083d8d]"></div>
                <span>KEPERCAYAAN</span>
                <div class="w-1 h-1 rounded-full bg-[#083d8d]"></div>
              </div>
              <div class="h-[1px] bg-[#083d8d] flex-grow"></div>
            </div>
          </div>
        </div>
        <p class="text-sm text-gray-500 leading-relaxed max-w-sm font-medium">
          Mitra terpercaya penyedia solusi komprehensif untuk perawatan HVAC, kolam renang, sistem filtrasi air (RO), panel surya, hingga instalasi mekanikal & kelistrikan (MEP).
        </p>
      </div>

      {/* Quick Links */}
      <div>
        <h4 class="font-extrabold text-[#0A1128] mb-6 tracking-tight">Tautan Cepat</h4>
        <ul class="space-y-4 text-sm font-medium text-gray-500">
          <li><a href="/#beranda" class="hover:text-[#083d8d] transition">Beranda</a></li>
          <li><a href="/#tentang-kami" class="hover:text-[#083d8d] transition">Tentang Kami</a></li>
          <li><a href="/#layanan" class="hover:text-[#083d8d] transition">Layanan</a></li>
          <li><a href="/#kontak" class="hover:text-[#083d8d] transition">Hubungi Kami</a></li>
        </ul>
      </div>

      {/* Contact Info */}
      <div>
        <h4 class="font-extrabold text-[#0A1128] mb-6 tracking-tight">Informasi</h4>
        <ul class="space-y-4 text-sm font-medium text-gray-500">
          <li class="flex items-start space-x-3">
            <MapPin className="w-4 h-4 mt-0.5 shrink-0 text-[#083d8d]" />
            <span>Jl. Bedugul No. 134 B, Sidakarya, Denpasar Selatan, Bali</span>
          </li>
          <li class="flex items-center space-x-3">
            <Phone className="w-4 h-4 shrink-0 text-[#083d8d]" />
            <span>+62 819-3252-3333</span>
          </li>
          <li class="flex items-center space-x-3">
            <Mail className="w-4 h-4 shrink-0 text-[#083d8d]" />
            <span>leon@gajatri.ic</span>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="border-t border-gray-100 pt-8 flex flex-col md:flex-row justify-between items-center">
      <p class="text-xs font-medium text-gray-400 mb-4 md:mb-0">
        &copy; {new Date().getFullYear()} PT. Gajatri Indo Service. Seluruh hak cipta dilindungi.
      </p>
      <div class="flex space-x-6 text-xs font-medium text-gray-400">
        <a href="#" class="hover:text-[#083d8d] transition">Syarat & Ketentuan</a>
        <a href="#" class="hover:text-[#083d8d] transition">Kebijakan Privasi</a>
      </div>
    </div>

  </div>
</footer>
