---
import pkg from "lucide-react";
const { CalendarCheck, ClipboardCheck, FileText, CheckCircle2 } = pkg;

const steps = [
  {
    icon: CalendarCheck,
    title: "Jadwal Terintegrasi",
    desc: "Sistem penugasan otomatis memastikan teknisi tepat waktu tanpa miss komunikasi."
  },
  {
    icon: ClipboardCheck,
    title: "Checklist Digital",
    desc: "Teknisi bekerja berlandaskan panduan digital cerdas, memastikan tidak ada langkah inspeksi yang terlewat."
  },
  {
    icon: FileText,
    title: "Laporan Real-Time",
    desc: "Klien langsung menerima bukti foto perbaikan dan laporan analitik kerusakan secara transparan sesaat setelah pekerjaan selesai."
  }
];
---

<section id="teknologi" class="max-w-[1400px] mx-auto px-6 pt-6 pb-12 md:pt-4 md:pb-16 scroll-mt-24 overflow-hidden">
  <div class="flex flex-col lg:flex-row gap-16 items-center">
    
    {/* Left: Device Mockups (Tablet + Phone) */}
    <div class="lg:w-1/2 flex justify-center reveal-up w-full">
      <div class="relative w-full max-w-[640px] h-[520px] mx-auto">
        
        {/* Floating App Brand (Above Tablet) */}
        <div class="absolute left-2 top-0 hidden sm:flex items-center space-x-4 z-0">
          <img src="/images/NextSite Logo App Black.svg" alt="NextSite" class="w-16 h-16 object-contain shrink-0" />
          <div>
            <div class="text-3xl font-extrabold text-[#0A1128] leading-tight">NextSite.</div>
            <div class="text-xs text-[#0A1128] font-bold tracking-widest uppercase">Force Field Automation</div>
          </div>
        </div>
        {/* Tablet Mockup (Background - Landscape) */}
        <div class="absolute left-0 top-20 w-[480px] lg:w-[500px] h-[360px] rounded-[2rem] border-[10px] border-[#0A1128] bg-white shadow-lg overflow-hidden hidden sm:block">
          {/* Tablet Camera Dot */}
          <div class="absolute top-0 left-1/2 -translate-x-1/2 h-4 w-4 bg-[#0A1128] rounded-b-xl z-10"></div>
          
          {/* Tablet Screen Content UI */}
          <div class="pt-6 px-6 pb-6 h-full flex flex-col bg-gray-50">
            {/* Header */}
            <div class="flex justify-between items-center mb-4 border-b border-gray-200 pb-3">
              <div class="flex flex-col">
                <div class="text-[10px] font-extrabold tracking-tighter uppercase leading-none mb-0.5 flex items-center space-x-1 whitespace-nowrap">
                  <span class="text-[#083d8d]">PT . GAJATRI</span>
                  <span class="text-[#474747]">INDO</span>
                  <span class="text-[#083d8d]">SERVICE</span>
                </div>
                <div class="text-[5px] font-bold tracking-widest text-[#474747] flex items-center space-x-0.5 uppercase whitespace-nowrap mt-0.5">
                  <div class="w-0.5 h-0.5 rounded-full bg-[#083d8d]"></div>
                  <span>SOLUSI</span>
                  <div class="w-0.5 h-0.5 rounded-full bg-[#083d8d]"></div>
                  <span>KUALITAS</span>
                  <div class="w-0.5 h-0.5 rounded-full bg-[#083d8d]"></div>
                  <span>KEPERCAYAAN</span>
                  <div class="w-0.5 h-0.5 rounded-full bg-[#083d8d]"></div>
                </div>
              </div>
              <div class="w-8 h-8 bg-[#083d8d]/10 rounded-full flex items-center justify-center">
                <div class="w-4 h-4 bg-[#083d8d] rounded-full"></div>
              </div>
            </div>
            
            {/* Dashboard Title */}
            <div class="mb-3">
              <h3 class="text-xs font-extrabold text-[#0A1128] uppercase tracking-widest">Executive Summary</h3>
            </div>
            
            <div class="flex flex-1 gap-4">
              {/* Sidebar/Stats */}
              <div class="w-1/3 flex flex-col gap-4">
                <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex-1 flex flex-col justify-center">
                  <div class="w-1/2 h-2 bg-gray-300 rounded-full mb-2"></div>
                  <div class="w-3/4 h-5 bg-[#0A1128] rounded-md"></div>
                </div>
                <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex-1 flex flex-col justify-center">
                  <div class="w-1/2 h-2 bg-gray-300 rounded-full mb-2"></div>
                  <div class="w-full h-5 bg-blue-500 rounded-md"></div>
                </div>
              </div>
            
              {/* Graph Mockup */}
              <div class="bg-white flex-1 rounded-xl shadow-sm border border-gray-100 p-4 flex flex-col justify-end space-y-2">
                <div class="flex items-end justify-between h-full space-x-3">
                  <div class="w-1/6 bg-blue-200 h-1/3 rounded-t-sm"></div>
                  <div class="w-1/6 bg-blue-300 h-1/2 rounded-t-sm"></div>
                  <div class="w-1/6 bg-[#083d8d] h-full rounded-t-sm"></div>
                  <div class="w-1/6 bg-blue-400 h-3/4 rounded-t-sm"></div>
                  <div class="w-1/6 bg-blue-200 h-2/5 rounded-t-sm"></div>
                  <div class="w-1/6 bg-blue-300 h-2/3 rounded-t-sm"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Phone Mockup (Foreground) */}
        <div class="absolute left-1/2 -translate-x-1/2 sm:left-auto sm:translate-x-0 sm:right-0 top-0 w-[260px] h-[520px] rounded-[2.5rem] border-[10px] border-[#0A1128] bg-white overflow-hidden z-10">
        {/* Notch */}
        <div class="absolute top-0 left-1/2 -translate-x-1/2 h-6 w-32 bg-[#0A1128] rounded-b-2xl z-10"></div>
        
        {/* Screen Content UI */}
        <div class="pt-16 px-6 pb-6 h-full flex flex-col bg-gray-50/50">
          
          {/* App Header */}
          <div class="flex items-center space-x-3 mb-8">
            <img src="/images/NextSite Logo App Black.svg" alt="NextSite" class="w-12 h-12 object-contain shrink-0" />
            <div>
              <div class="text-lg font-extrabold text-[#0A1128]">NextSite.</div>
              <div class="text-[10px] text-blue-500 font-bold tracking-tight">Force Field Automation</div>
            </div>
          </div>
          
          {/* Work Orders List */}
          <div class="space-y-3">
            <div class="text-xs font-bold text-gray-500 mb-2">Tugas Hari Ini</div>
            
            {/* Task 1: Completed */}
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 flex items-start space-x-3 transition hover:border-[#083d8d]/30">
              <div class="mt-1"><CheckCircle2 className="w-5 h-5 text-blue-500" /></div>
              <div class="flex-1">
                <div class="text-sm font-bold text-[#0A1128] mb-1">HVAC - Lantai 4</div>
                <div class="w-full h-1.5 bg-gray-100 rounded-full mb-1"></div>
                <div class="w-2/3 h-1.5 bg-gray-100 rounded-full"></div>
              </div>
            </div>
            
            {/* Task 2: In Progress (Highlighted) */}
            <div class="bg-[#083d8d] p-4 rounded-2xl shadow-lg shadow-[#083d8d]/20 border border-[#083d8d] flex items-start space-x-3 relative overflow-hidden">
              <div class="absolute right-0 top-0 w-24 h-24 bg-white/10 rounded-full -mr-8 -mt-8"></div>
              <div class="mt-1"><ClipboardCheck className="w-5 h-5 text-white" /></div>
              <div class="flex-1 relative z-10">
                <div class="text-sm font-bold text-white mb-2">Inspeksi Chiller A</div>
                {/* Progress Bar */}
                <div class="w-full h-1.5 bg-white/20 rounded-full overflow-hidden mb-2">
                  <div class="w-3/4 h-full bg-white rounded-full"></div>
                </div>
                <div class="text-[10px] text-white/80 font-medium">Langkah 7/10 - Filter Pengecekan</div>
              </div>
            </div>
            
            {/* Task 3: Pending */}
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 flex items-start space-x-3 opacity-60">
              <div class="mt-1"><CalendarCheck className="w-5 h-5 text-gray-400" /></div>
              <div class="flex-1">
                <div class="text-sm font-bold text-gray-400 mb-1">Plumbing MEP</div>
                <div class="w-3/4 h-1.5 bg-gray-100 rounded-full mb-1"></div>
                <div class="w-1/2 h-1.5 bg-gray-100 rounded-full"></div>
              </div>
            </div>
            
          </div>
          
          {/* Bottom Nav Mockup */}
          <div class="mt-auto pt-4 border-t border-gray-100 flex justify-between px-2">
            <div class="w-8 h-8 rounded-full bg-gray-200"></div>
            <div class="w-8 h-8 rounded-full bg-[#083d8d]"></div>
            <div class="w-8 h-8 rounded-full bg-gray-200"></div>
          </div>
        </div>
      </div>
        
      {/* Powered by Text (Below Tablet) */}
      <div class="absolute left-6 bottom-4 hidden sm:block text-sm text-gray-400 font-medium lowercase z-0">
        powered by <span class="font-extrabold text-gray-600">apialedev.</span>
      </div>
    </div>
  </div>
    
    {/* Right: Texts & Steps */}
    <div class="lg:w-1/2">
      <h2 class="text-4xl lg:text-[3.5rem] font-extrabold text-[#0A1128] mb-4 leading-[1.1] tracking-tight reveal-up">
        Operasional cerdas berbasis <span class="text-[#083d8d]">teknologi</span>.
      </h2>
      <p class="text-gray-600 mb-6 text-base leading-relaxed font-normal reveal-up delay-100">
        Armada teknisi kami dibekali sistem terintegrasi yang menjamin setiap pekerjaan berjalan sistematis dan tercatat sempurna.
      </p>
      
      <div class="space-y-3">
        {steps.map((step, index) => {
          const Icon = step.icon;
          return (
            <div class={`flex space-x-5 reveal-up delay-${(index + 2) * 100}`}>
              <div class="w-12 h-12 rounded-2xl bg-[#F0F5FF] flex flex-shrink-0 items-center justify-center text-[#083d8d]">
                <Icon className="w-5 h-5" strokeWidth={2.5} />
              </div>
              <div>
                <h4 class="text-lg font-extrabold text-[#0A1128] mb-1">{step.title}</h4>
                <p class="text-gray-600 font-normal leading-relaxed text-sm">{step.desc}</p>
              </div>
            </div>
          )
        })}
      </div>
    </div>
    
  </div>
</section>
