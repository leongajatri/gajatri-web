---
// Hero.astro
import pkg from "lucide-react";
const { ArrowRight } = pkg;

const heroImage = '/images/hero_gis_new.jpg';
---
<section class="max-w-[1400px] mx-auto px-6 relative mt-6">
  <div class="w-full relative min-h-[500px] lg:min-h-[550px] rounded-[2rem] overflow-hidden flex items-end">
    {/* Full Width Background Image */}
    <img src={heroImage} alt="Professional Technician" class="absolute inset-0 w-full h-full object-cover object-left-top" />
    
    {/* Gradient Overlay for Text Readability */}
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent md:bg-gradient-to-r md:from-black/80 md:via-black/40 md:to-transparent"></div>
    
    {/* Overlay Content */}
    <div class="relative z-10 w-full max-w-2xl p-8 pb-12 md:p-16 md:pb-20">
      <h1 class="text-4xl md:text-5xl lg:text-[4.5rem] font-extrabold leading-[1.05] mb-6 text-white tracking-tighter reveal-up">
        Layanan<br/>
        engineering &<br/>
        maintenance<br/>
        profesional
      </h1>
      
      <p class="text-gray-200 text-base lg:text-lg mb-8 max-w-xl font-normal leading-relaxed reveal-up delay-100">
        Solusi terpercaya untuk seluruh kebutuhan<br/>perawatan dan perbaikan sistem operasional bisnis Anda.
      </p>

      <div class="reveal-up delay-200">
        <a href="/#kontak" class="inline-flex bg-[#083d8d] text-white px-8 py-3.5 rounded-full font-bold text-xs uppercase tracking-wide hover:bg-[#062b66] transition items-center space-x-3">
          <span>Konsultasi Gratis</span>
          <div class="w-6 h-6 bg-white/20 rounded-full flex items-center justify-center">
            <ArrowRight className="w-3.5 h-3.5" />
          </div>
        </a>
      </div>
    </div>
  </div>
</section>
